+// Rift: work rc_params and hrd_params out again for a bitrate or maxrate
+// moved since they were last set, the way vaapi_encode_init_rate_control
+// does, keeping the buffer's length in time.
+static int vaapi_encode_move_bit_rate(AVCodecContext *avctx)
+{
+    VAAPIEncodeContext *ctx = avctx->priv_data;
+    int64_t rate = avctx->bit_rate;
+    int64_t bits;
+    int percent;
+
+    if (rate <= 0)
+        return AVERROR(EINVAL);
+    if (ctx->rc_mode->maxrate) {
+        bits = avctx->rc_max_rate > 0 ? FFMAX(avctx->rc_max_rate, rate)
+                                      : 2 * rate;
+        percent = rate * 100 / bits;
+    } else {
+        bits = rate;
+        percent = 100;
+    }
+    if (bits > UINT32_MAX)
+        return AVERROR(EINVAL);
+
+    if (ctx->rc_mode->hrd && ctx->rc_params.bits_per_second) {
+        ctx->hrd_params.buffer_size =
+            av_rescale(ctx->hrd_params.buffer_size, bits,
+                       ctx->rc_params.bits_per_second);
+        ctx->hrd_params.initial_buffer_fullness =
+            av_rescale(ctx->hrd_params.initial_buffer_fullness, bits,
+                       ctx->rc_params.bits_per_second);
+    }
+    ctx->rc_params.bits_per_second   = bits;
+    ctx->rc_params.target_percentage = percent;
+    ctx->va_bit_rate                 = bits;
+    ctx->rc_set_bit_rate = avctx->bit_rate;
+    ctx->rc_set_max_rate = avctx->rc_max_rate;
+
+    av_log(avctx, AV_LOG_VERBOSE, "RC target moved: %d%% of %"PRId64" bps.\n",
+           percent, bits);
+    return 0;
+}
