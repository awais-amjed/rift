# Short cargo target dir, kept near the root to stay under MAX_PATH on Windows
/ck/

# Credentials. Never committed, and listed by shape rather than by name so the
# next one to arrive is covered before somebody has to remember.
#
# rift-service-key.json is the Firebase service account that signs FCM sends.
# google-services.json is per-project too. Keystores sign releases; losing one
# means never updating that app again, and leaking one means anyone can.
*service-key*.json
*service-account*.json
google-services.json
GoogleService-Info.plist
*.jks
*.keystore
key.properties
android/.kotlin/

# Local scratch tooling — headless members, probes, one-off scripts. Never
# tracked: it holds throwaway credentials paths and is written against whatever
# was being debugged that day. Ignored rather than merely untracked, because a
# `git add -A` catches it otherwise, and once did.
#
# `tool/*` rather than `tool/`, because git does not descend into an excluded
# directory and the negation below would never be reached.
tool/*

# The exception, and it has to be one: this is the documented way to regenerate
# `test/wire_vectors.json` — WIRE.md, rift_crypto and wire_test.dart all name it
# — and the contract it maintains now spans two repositories. A clone that
# cannot run it cannot change the wire format at all. It reads nothing and
# talks to nothing; it derives.
!tool/gen_wire_vectors.dart

# Build artefacts of the packages that are tracked.
rift_crypto/.dart_tool/
rift_crypto/pubspec.lock
bot_sdk_ts/node_modules/

# Compiled by scripts/build_web.sh from the resolved livekit_client.
/web/e2ee.worker.dart.js*

# A literal "~" folder a tool once created here; never commit it
/~/

# Design handoffs kept beside the code, not in it
/App icon design concepts-2/
/Mobile app redesign request-handoff*/
