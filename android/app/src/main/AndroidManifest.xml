<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Everything the app does is over the network: Supabase for the server,
         LiveKit for the call. Without this it builds and then reaches nothing,
         which looks exactly like every server being offline. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Voice and video. RECORD_AUDIO also arrives from the `record` plugin's
         own manifest, but it is stated here because it belongs to the app
         rather than to a dependency — dropping voice notes one day must not
         silently take the microphone with them. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Routing a call to a Bluetooth headset. API 31 split this out of the
         legacy pair, which older devices still need. This set is the one
         LiveKit's own Flutter example declares. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>

    <!-- WebRTC reacts to the network moving under a live call. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>

    <!-- So a call survives the screen going off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- A foreground service is what keeps a call alive once the app is in
         the background — LiveKit's SDK does not run one — and from Android 14
         it is also what MediaProjection refuses to start without.
         The two want different declared types, so the service below lists
         both as what it *may* be and each start picks which it actually is:
         a plain call cannot satisfy mediaProjection's prerequisites, so it
         must not claim that type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>

    <!-- Declared not-required so the app still installs on hardware without
         them: a tablet with no camera can still read and type. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:label="Rift"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- supportsPictureInPicture: a video call should survive leaving the
             app — the window shrinks to a floating one instead of the call
             going away. MainActivity decides when, and only arms it while
             there is something to see. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:supportsPictureInPicture="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Name fixed by flutter_foreground_task. stopWithTask, because a
             call cannot outlive the app: without it, swiping the app away
             leaves a notification for a call that is over. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="microphone|camera|mediaProjection"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
